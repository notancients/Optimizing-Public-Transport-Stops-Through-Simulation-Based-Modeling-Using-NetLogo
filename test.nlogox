<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code><![CDATA[extensions [ csv nw py]


globals [
  global-test
  global-test-result
  ;;;;;;;;;;;;;;;;;;;;;
  ;;;;;;;;;;;;;;;;;;;;;
  nodes-hidden
  buildings-hidden
  vehicles-hidden
  pedestrians-hidden

  ;;;;;;;;;;;;;;;;;;;;;
  ;;;;;;;;;;;;;;;;;;;;;
  was-editing-route?
  was-mouse-down?
  ; global-jeep-capacity ; exists in the interface area, holds the possible values of jeep capacities
  
  route-names
  draft-jeepney-route-nodes ; this will hold the list of nodes
  complete-jeepney-routes; list of lists contains a list of all TURTLE nodes per route
  
  routes-highlighted?
  ;;;;;;;;;;;;;;;;;;;;;
]

; Agents and road network
breed [ nodes node ]
nodes-own [ 
  node-id 
  is-route-end?
  is-transport-stop?
  routes ; list that contains all routes that a node belongs to
  in-drivable-path? ; would mostly be used only for route checking/pathfinding; other details would still be reliant on road-type
]


directed-link-breed [ roads road ]
roads-own [ 
  road-length 
  road-type
  lanes
  max-speed
  access
  is-oneway?
  road-name
]

breed [ buildings building ] ;were converting buildings into turtles instead of patches to avoid overwrite
buildings-own [
  building-id
  category
  name
  nearest-road-node ; this will be set during the setup so that we can just check which road node to pathfind to
]


breed [ pedestrians pedestrian ]

pedestrians-own [ 
  ped-id
  destination-node 
  destination-building
  route
  age
  house
  work-school
  allelomimetic
  distance-walked
  walking-time
  waiting-tolerance
  distance-tolerance
  transportation-preference
  unruliness
  jaywalking
  speed
  ride-id
  status ; 'riding', 'walking', 'walking-to-stop', 'waiting-at-stop'
]

breed [vehicles vehicle]

vehicles-own [
  destination-node
  route
  speed
  max-capacity
  current-capacity
  is-public?          ; previously category, switched to boolean for cheaper calculations
  unruliness
  boarding-time
  alighting-time
  dwell-time
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to thetop 
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Networking helper functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to context-use-road-network-only
  nw:set-context nodes roads with [
    member? road-type ["primary" "secondary" "tertiary" "residential"]
    and
    not member? access ["no" "private"]
  ]
end

to context-reset-network
  nw:set-context nodes roads
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Map Setup
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to fetch-roads
  ; py:setup "python3"
  ; py:run "from population import generate_population"

  ; py:run "generate_population"
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to fetch-buildings

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to generate-population

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to load-map
  clear-all
  
  ; Initialize globals
  set nodes-hidden false
  set buildings-hidden true
  set vehicles-hidden false
  set pedestrians-hidden false
  set was-mouse-down? false
  
  set is-editing-route? false
  set was-editing-route? false
  set draft-jeepney-route-nodes []
  set complete-jeepney-routes []
  set route-names []
  set routes-highlighted? false
  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  
  
  let node-data csv:from-file "nodes.csv"
  set node-data but-first node-data
  
  foreach node-data [ row ->
    create-nodes 1 [
      set node-id item 0 row
      set xcor item 1 row
      set ycor item 2 row
      
      set shape "circle"
      set size 0.3
      set color [255 0 0 128]
      set hidden? nodes-hidden
      set is-transport-stop? true
      set routes []
    ]
  ]

  ; Load edges (streets and walkways)
  let edge-data csv:from-file "edges.csv"
  set edge-data but-first edge-data 
  
  foreach edge-data [ row ->
    let source-id item 0 row
    let target-id item 1 row
    let r-length item 2 row
    let r-type item 3 row
    let r-name item 4 row
    let r-way item 5 row
    let r-speed item 6 row
    let r-access item 7 row
    let r-lane item 8 row
    
    let source-node one-of nodes with [node-id = source-id]
    let target-node one-of nodes with [node-id = target-id]
    
    if source-node != nobody and target-node != nobody and source-node != target-node [
      ask source-node [
        create-road-to target-node [
          set road-length r-length  
          set road-type r-type

          set road-name r-name
          set lanes r-lane
          set max-speed r-speed
          set access r-access
          set is-oneway? r-way
          
          set color white
          set thickness 0.1
        ]
      ]
    ]
  ]
  
  ; add the helper tag for the node clicking function to reduce load whenever clicking
  ask nodes [
    let drivable-types ["primary" "secondary" "tertiary" "residential" "service"]
    set in-drivable-path? 
    any? my-in-roads with [ member? road-type drivable-types ]
    or
    any? my-out-roads with [ member? road-type drivable-types ]
  ]
 
  ; Load buildings
  let bldg-data csv:from-file "buildings.csv"
  set bldg-data but-first bldg-data

  foreach bldg-data [ row ->
    let target-id item 0 row
    let target-name item 1 row
    let target-x item 2 row
    let target-y item 3 row
    let target-category item 4 row

    ; making sure that the building is within the bounds of the simulation
    ; since there might be buildings that are not directly connected to the road network
    ; which is the limiter for the bounding box
    if (target-x >= min-pxcor and target-x <= max-pxcor and target-y >= min-pycor and target-y <= max-pycor) [
      create-buildings 1 [
        setxy target-x target-y
        set category target-category
        set name target-name
        set building-id target-id
        set shape "house"
        set size 0.5
        set hidden? true
        
        ; we're just assigning different colors to each 'house' symbol for the building
        (ifelse
          target-category = "commercial" [ set color yellow ]
          target-category = "school" [ set color blue ]
          target-category = "residential" [ set color green ]
          target-category = "special" [ set color violet ]
          target-category = "miscellaneous" [ set color [150 75 0 180] ] ; brown slightly transparent (RGBA)
        )
        
        set nearest-road-node min-one-of nodes [distance myself]
        
      ]
    ]
    
  ]


  reset-ticks
  

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Spawn entities
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to spawn-pedestrians 
    ; 4. Spawn Pedestrians

  ;create-pedestrians 50 [
  ;  move-to one-of nodes
  ;  set shape "person"
  ;  set color red
  ;  set size 1.5
  ;  set route []
  ;]
  
  let pop-data csv:from-file "pedestrians.csv"
  set pop-data but-first pop-data
  
  foreach pop-data [ row ->
    create-pedestrians 1 [
      move-to one-of nodes
      set age item 0 row
      set house item 1 row
      set work-school item 2 row
      set waiting-tolerance item 3 row
      set distance-tolerance item 4 row
      set transportation-preference item 5 row
      set unruliness item 6 row
      set jaywalking item 7 row
      set speed item 8 row
      set allelomimetic item 9 row
      
      set route []
      set distance-walked 0
      set walking-time 0
      
      set destination-building one-of buildings
      
      set shape "person"
      set size 1.2
      set color blue
    ]
  ]
end

to spawn-vehicles 
  create-vehicles 100 [
    move-to one-of nodes
    set shape "car"
    set color blue
    set size 2
    set speed 2
    set route []
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Record routes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to record-route
  
  if is-editing-route? [
    ; need to check if the mouse was not clicked previously to save just one click
    if mouse-down? and not was-mouse-down? [
      
      ; this is for resetting all the colored nodes
      ask nodes with [color = green] [
        set color red
        set size 0.3
      ]
      
      let clicked-node min-one-of (nodes with [in-drivable-path?]) [distancexy mouse-xcor mouse-ycor]
      
      ; if there was a clicked node
      if clicked-node != nobody [
        
        
        print (word "CLICKED Node " [who] of clicked-node " | OSM: " [node-id] of clicked-node " | Stop?: " [is-transport-stop?] of clicked-node)
        
        if not is-list? draft-jeepney-route-nodes [
          print (word "NOT LIST CONDITION")
          set draft-jeepney-route-nodes []
        ]
        
        ; color all next available nodes
        
        ifelse empty? draft-jeepney-route-nodes
        [
          print (word "First node!")
          set draft-jeepney-route-nodes lput clicked-node draft-jeepney-route-nodes
        ]
        [
         print length draft-jeepney-route-nodes
         let last-added-node last draft-jeepney-route-nodes
         
         context-use-road-network-only
         let road-segment [nw:turtles-on-weighted-path-to clicked-node "road-length"] of last-added-node
         print (word "Road segment: " road-segment)

         ifelse is-list? road-segment
         [
            let temp-list sentence draft-jeepney-route-nodes but-first road-segment
            set draft-jeepney-route-nodes temp-list
         ]
         [
            user-message (word "That is an invalid next node. Please select a different route.")
         ] ; end of checking for road segment
        ] ; end of checking for empty draft nodes
        
        if not empty? draft-jeepney-route-nodes [
          ask last draft-jeepney-route-nodes [
           ask out-link-neighbors [
             set color green
             set size 0.5
           ]
         ]
         display
        ]
      ]
    ]
    set was-mouse-down? mouse-down?
  ]
  
  ; save route
  if not is-editing-route? and length draft-jeepney-route-nodes > 1 [
    let route-name user-input "Enter route name: "
    foreach draft-jeepney-route-nodes [ element ->
      ask element [
        set routes lput route-name routes
      ]
    ]
    
    set route-names lput route-name route-names
    
    set complete-jeepney-routes lput draft-jeepney-route-nodes complete-jeepney-routes
    set draft-jeepney-route-nodes []
    
    context-reset-network
    ask nodes with [color = green] [
      set color red
      set size 0.3
    ]
    display
    stop
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Export Routes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to export-route
  if empty? complete-jeepney-routes [
    user-message "You haven't saved any routes yet."
    stop
  ]
  
  let file-name user-input "Enter desired filename (do not include .csv): "
  ; for each route we have, create new lists containing their node-id from osm so that we can load them
  ; again
  let formatted-for-csv map [
    jeep-route -> map [element -> [node-id] of element] jeep-route
  ] complete-jeepney-routes 
  csv:to-file (word file-name ".csv") formatted-for-csv
  
  csv:to-file (word file-name "-" "route-names" ".csv") (list route-names)

  
  user-message (word "Route successfully saved to " file-name ".csv!")
  
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Load Routes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to load-route
  ; translate the node-ids that we saved into the corresponding turtles
  
  let file-name user-input "Enter file to load (do not include .csv: "
  
  set route-names first csv:from-file (word file-name "-" "route-names" ".csv")
  
  let loaded-routes csv:from-file (word file-name ".csv")
  print loaded-routes
  
  foreach loaded-routes [ loaded-route ->
    let translated-route map [ loaded-id -> one-of nodes with [node-id = loaded-id] ] loaded-route
    
    set complete-jeepney-routes lput translated-route complete-jeepney-routes
  ]
  
  (foreach route-names loaded-routes [ [loaded-name loaded-route] ->
    
    let translated-route []
    
    foreach loaded-route [ loaded-id ->
      let loaded-node one-of nodes with [node-id = loaded-id]
      ask loaded-node [
        set routes lput loaded-name routes
      ]
      
      set translated-route lput loaded-node translated-route
    ]
    set complete-jeepney-routes lput translated-route complete-jeepney-routes
  ])
  
  
end

to highlight-routes
  ifelse not routes-highlighted? [
    set routes-highlighted? not routes-highlighted?
    foreach complete-jeepney-routes [ coloring-route -> 
      (foreach (but-last coloring-route) (but-first coloring-route) [ [from-node to-node] -> 
        ask from-node [
          ask link-with to-node [
            set thickness 0.3
            set color red
          ]
        ]
      ])
    ]
    
    ask roads with [color = white] [
      set thickness 0.008
    ]
  ]
  [
    set routes-highlighted? not routes-highlighted?
    ask roads with [color = white] [
      set thickness 0.1
    ]
    ask roads with [color = red] [
      set color white
      set thickness 0.1
    ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Spawn jeepneys
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to spawn-jeepneys
  ; Check if the jeepney per route variable is empty
  if empty? jeepney-per-route [
    user-message "You haven't inputted the proper amount of jeepney per route yet."
    stop
  ]
  ; convert the string into a list of numbers
  let num-arr-jeepney-per-route read-from-string jeepney-per-route
  
  ; Check if the routes list are empty
  if empty? complete-jeepney-routes [
    user-message "You have not designated any jeepney routes yet."
    stop
  ]
  
  ; Check if route count is compatible with the jeepney per route count
  if (length complete-jeepney-routes) != (length num-arr-jeepney-per-route) [
    user-message "Incompatible length between amount of routes and declared jeepneys per route."
    stop
  ]
  
  if (length global-jeep-capacity) = 0 [
    user-message "You have not inputted the capacity possible per jeep"
    stop
  ]
  
  ; Spawn a corresponding amount of jeepneys per route
  let i 0
  while [i < (length complete-jeepney-routes)] [
    let curr-route item i complete-jeepney-routes
    let jeep-count item i num-arr-jeepney-per-route
    create-vehicles jeep-count [
      
      move-to one-of curr-route
      set shape "car"
      set color green
      set size 2
      set speed 2
      set route curr-route
      set is-public? true
      set max-capacity one-of read-from-string global-jeep-capacity
    ]
    set i i + 1
  ]
  
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Go
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to set-pedestrian-route
  if not is-list? route or empty? route [
  
  ; if they don't have a destination yet, set a new destination
  ; this can be done either by allelomimesis or just randomly setting
  ; on their own
  ; Identify allelomimesis
  let check-allelomimesis random-float 1.0
  
  ; if fit within allelomimesis copy the destination of someone in the area
  ifelse check-allelomimesis < allelomimetic and any? other pedestrians in-radius 2 
  [ ; if there we will copy and there is someone we can copy
    let person-to-copy one-of other pedestrians in-radius 2
    let copied-destination [destination-building] of person-to-copy
    set destination-building copied-destination
  ]
  [ ; if we're deciding on our own and there is no one to copy
    set destination-building one-of buildings
  ]
  
  
  ; once we have a destination, determine if we're gonna walk or ride a jeep
  let check-transportation-preference random-float 1.0
  
  ; additionally, check if the distance is too far
  ; for now, this is gonna be using basic euclidean distance
  let is-too-far? (distance destination-building > distance-tolerance)

  ifelse (check-transportation-preference < transportation-preference) and (is-too-far?)
  [
    set status "walking-to-stop"
    ; set a new route to the nearest stop that leads to their destination
    
    ; identify the nearest transport stop nodes to the destination
    let candidate-dropoffs min-one-of (nodes with [is-transport-stop?]) [distance [destination-building] of myself]
    
    ; identify the nearst stop to the origin point (where the user is standing) that is in the same route
    ; as the one nearest to the destination
    let local-distance-tolerance distance-tolerance
    let candidate-pickups (nodes with [is-transport-stop?]) in-radius local-distance-tolerance
    ; if there are no transport stops within the acceptable walking tolerance, expand the search radius
    ; MARK THIS INCONVENIENCE IN THE REPORTER
    if not any? candidate-pickups [
      set local-distance-tolerance local-distance-tolerance + distance-tolerance
      set candidate-pickups nodes with [is-transport-stop?] in-radius local-distance-tolerance 
    ]
    
    foreach complete-jeepney-routes [
      
    ]

    ; set the route to first go to the pickup point, then add a waiting indicator
    let closest-road-node-to-pedestrian min-one-of nodes [distance myself]
    ; set a route going from the drop off to the destination
  ]
  [
    set status "walking"
    ; set a new route to their destination just by walking
    
    ; determine the node via road that is closest to their destination building
    let closest-road-node-to-pedestrian min-one-of nodes [distance myself]
    let closest-road-node-to-destination [nearest-road-node] of destination-building
    
    let route-from-road-to-destination [nw:turtles-on-weighted-path-to closest-road-node-to-destination "road-length"] of closest-road-node-to-pedestrian  
    set route lput destination-building route-from-road-to-destination
  ]
  
]
end
  
  
to go

  ; Pedestrian Logic
  
  ask pedestrians [
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ; 1. Pick destination if needed
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    

    
    
    set-pedestrian-route
    
    
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ; 2. Movement
    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    
    ; change how they move depending what they're currently doing
    ( if-else
      ; just move them along with the jeepney that they are riding
      status = "riding"
      [
        set color violet
      ]
      
      ; normal walking procedure
      status = "walking"
      [
        set color green
        
        let next-node first route
        face next-node  
        
        ifelse distance next-node < speed [
          move-to next-node
          set route but-first route
        ] [
          fd speed
        ]
        
        ; increment counters for the pedestrian
        set distance-walked distance-walked + speed
        set walking-time walking-time + 1
      ]
      
      ; only purpose is to walk to the stop for their next destination change to waiting as soon as done
      status = "walking-to-stop"
      [
        set color orange
        die
      ]
      
      ; waiting for a jeepney at their stop, change to riding once onboarding
      status = "waiting"
      [
        set color yellow
      ]
      
    )
  ]
  



  ; Vehicle Logic
  ask vehicles [
    if (not is-public?) [
      ; Pick destination
      if not is-list? route or empty? route [
        
        set destination-node one-of nodes 
        
        let my-node min-one-of nodes [distance myself]
        let my-dest destination-node 
        
        set route [nw:turtles-on-weighted-path-to my-dest "road-length"] of my-node
        
        ifelse route != false [
          if not empty? route [
            if first route = my-node [
              set route but-first route
            ]
          ]
        ] [
          set route [] 
        ]
      ]
  
      ; Drive to destination - implement blocking
        if is-list? route and not empty? route [
        let next-node first route
        
        if current-capacity > 0 [
          face next-node
          fd speed
          
          if distance next-node < speed [
            move-to next-node
            set route but-first route
          ]
        ]
        
  
      ]
    ]
    
    if (is-public?) [
    ]
    
    
  ]
  
  
  tick
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="2145" showTickCounter="true" patchSize="20.0" fontSize="10" wrappingAllowedY="false" width="2145" tickCounterLabel="ticks" maxPycor="100" updateMode="1" maxPxcor="100" minPxcor="0"></view>
    <button x="255" y="155" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="100" display="Show/Hide Vehicles">set vehicles-hidden not vehicles-hidden

ask vehicles [
  set hidden? vehicles-hidden
]</button>
    <button x="135" y="155" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="115" display="Show/Hide Pedestrians">set pedestrians-hidden not pedestrians-hidden

ask pedestrians [
