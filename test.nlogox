reset-ticks</button>
    <monitor x="90" precision="0" y="640" height="60" fontSize="11" width="100" display="Pedestrian count">count pedestrians</monitor>
    <button x="155" y="465" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="76" display="Load Map">load-map</button>
    <button x="145" y="510" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="115" display="Route Debugging">print (word "Draft: " draft-jeepney-route-nodes)
print (word "Complete: " complete-jeepney-routes)
print (word "Route names: " route-names)</button>
    <button x="45" y="510" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="90" display="Reset routes">set draft-jeepney-route-nodes []
set complete-jeepney-routes []
ask nodes [set color red]
set is-editing-route? false
clear-output</button>
